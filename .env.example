################################################################################
# EPIC — Economic Policy and Innovation Centre
#
# Copy this file to `.env` and fill in the values for your environment.
# The Hostinger settings you need are in DEPLOYMENT.md.
################################################################################

APP_NAME="EPIC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Local time zone — reports and "today" follow this.
APP_TIMEZONE=UTC
# APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#-------------------------------------------------------------------------------
# Database
#
# Local development uses SQLite out of the box (no server needed).
# On Hostinger, comment out the SQLite line and use the MySQL block instead.
#-------------------------------------------------------------------------------
DB_CONNECTION=sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456789_epic
# DB_USERNAME=u123456789_epic
# DB_PASSWORD=

#-------------------------------------------------------------------------------
# Sessions, cache and queues
#-------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

#-------------------------------------------------------------------------------
# Email
#
# Contact, volunteer and subscribe submissions are always stored in the
# dashboard. If SMTP is configured below they are also emailed to the
# "Send form notifications to" address in Dashboard → Site settings → Contact.
#-------------------------------------------------------------------------------
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=info@your-domain.com
# MAIL_PASSWORD=
# MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="info@epic.org.pk"
MAIL_FROM_NAME="${APP_NAME}"

#-------------------------------------------------------------------------------
# First super admin account (used only by `php artisan epic:install`)
#-------------------------------------------------------------------------------
EPIC_ADMIN_NAME="EPIC Super Admin"
EPIC_ADMIN_EMAIL=admin@epic.org.pk
EPIC_ADMIN_PASSWORD=EpicAdmin@2025
